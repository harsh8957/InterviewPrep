# ==============================================================================
# InterviewPrep Local Development Environment Template
# Copy to backend/.env and evaluator_service/.env for local development
# ==============================================================================

NODE_ENV=development
PORT=5000

# Local JWT Secret (Required)
JWT_SECRET=dev_jwt_secret_change_in_production_32chars!

# Internal Microservice Key
INTERNAL_SERVICE_KEY=dev_internal_secret_change_me

# MongoDB Local URI
MONGODB_URI=mongodb://127.0.0.1:27017/echoprep_dev

# Service Endpoints
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
EVALUATOR_SERVICE_URL=http://localhost:8001

# Gemini AI (Required for live AI interviews and evaluation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Judge0 CE (Required for live code execution in problem workspace)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
