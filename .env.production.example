# ==============================================================================
# InterviewPrep Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Security: Mandatory 32+ character cryptographically random JWT signing secret
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_strong_random_jwt_secret_32_chars_minimum

# Security: Shared internal key between Express API and FastAPI Evaluator
INTERNAL_SERVICE_KEY=replace_with_internal_microservice_shared_secret

# MongoDB Database Connection String (Internal container host or managed cluster)
MONGODB_URI=mongodb://mongo:27017/echoprep_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
SLOW_QUERY_THRESHOLD_MS=150

# Application URLs
FRONTEND_URL=https://interviewprep.yourdomain.com
BACKEND_URL=https://interviewprep.yourdomain.com/api
EVALUATOR_SERVICE_URL=http://evaluator:8001

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_SECONDS=30.0

# Judge0 Online Code Execution Infrastructure
# Option A: RapidAPI Hosted Judge0 CE
# Option B: Dedicated Hardened Linux Worker (see deploy/JUDGE_DEPLOYMENT.md)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE_PROVIDER=rapidapi_judge0
SUBMISSION_TIMEOUT_MS=15000

# Rate Limiting Overrides (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
